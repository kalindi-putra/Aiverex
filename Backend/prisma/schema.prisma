datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Student {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  createdAt  DateTime @default(now())
}

model Mentor {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  password    String
  expertise   String?
  createdAt   DateTime @default(now())
  role        String   @default("mentor")
  company     String?
  experience  String?
  resumeLink  String?
  githubLink  String?
}

